---
import { languages, localizedPath, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { pathname } = Astro.url;

const labels: Record<Lang, string> = { es: 'ES', en: 'EN' };
---

<div class="lang-switch">
  {
    languages.map((target) => (
      <a
        href={localizedPath(pathname, target)}
        hreflang={target}
        lang={target}
        aria-current={target === lang ? 'page' : undefined}
      >
        {labels[target]}
      </a>
    ))
  }
</div>

<style>
  .lang-switch {
    display: flex;
    gap: 8px;
  }

  .lang-switch a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 4px;
    color: var(--soft);
    text-decoration: none;
  }

  .lang-switch a:hover,
  .lang-switch a[aria-current='page'] {
    color: var(--ink);
  }
</style>
