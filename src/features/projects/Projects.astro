---
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const words = t('work.mask').split('|');
---

<section id="projects" aria-labelledby="projects-title" class="section">
  <!--
    A still stage: a sticky 100svh stage inside a tall track. The footage stays put; the area words converge
    from the outside in as the track scrolls (scrubbed by GSAP ScrollTrigger), settle by CONVERGE_END of the
    track, and then hold. Reduced motion skips the scrub and renders the words in their final places.
    The particle layer stays off here through the page wrapper's data-particles="none".
  -->
  <h2 id="projects-title" class="sr-only">{t('work.title')}: {words.join(', ')}</h2>

  <div class="stage">
    <video
      class="bg"
      muted
      loop
      playsinline
      autoplay
      preload="metadata"
      poster="/video/projects-coast-poster.jpg"
      aria-hidden="true"
      data-project-video
    >
      <source src="/video/projects-coast-720.webm" type="video/webm" media="(max-width: 767px)" />
      <source src="/video/projects-coast-1080.webm" type="video/webm" />
      <source src="/video/projects-coast-720.mp4" type="video/mp4" media="(max-width: 767px)" />
      <source src="/video/projects-coast-1080.mp4" type="video/mp4" />
    </video>
    <div class="veil" aria-hidden="true"></div>

    <p class="words" aria-hidden="true">
      {words.map((word) => <span>{word}</span>)}
    </p>
  </div>
</section>

<style>
  .section {
    /* Scroll held beyond the 100svh stage, in svh. This is the one value to tune the track length. */
    --hold: 300;
    position: relative;
    isolation: isolate;
    height: calc(100svh + var(--hold) * 1svh);
    /* Clips the sticky stage at the section's bottom edge. overflow: clip, unlike hidden, keeps sticky working. */
    overflow: clip;
    color: var(--ink);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--bg);
  }
  /* 2px of flat --bg above and below the footage. The video sits on its own GPU layer and snaps to whole
     pixels, while the section edge lands on fractions: without this margin the boundary row shows a hairline
     of unveiled footage. */
  .bg {
    position: absolute;
    inset: 2px 0;
    display: block;
    width: 100%;
    height: calc(100% - 4px);
    object-fit: cover;
  }
  /* Token-based veil: 60% --bg darkens the footage in the dark theme and lightens it in the light theme,
     so --ink reads in both. Flat on purpose: the stage stays clean while it is stuck. */
  .veil {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    pointer-events: none;
  }
  /* Edge fades. They belong to the section, not to the sticky stage, so they travel with the section:
     on entry the first rows of footage, and the words that start outside the frame, melt out of the flat
     --bg of the previous section instead of being cut by the section edge; on exit the same in reverse. */
  .section::before,
  .section::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 35svh;
    z-index: 2;
    pointer-events: none;
  }
  .section::before {
    top: 0;
    background: linear-gradient(to bottom, var(--bg), transparent);
  }
  .section::after {
    bottom: 0;
    background: linear-gradient(to top, var(--bg), transparent);
  }
  .words {
    position: absolute;
    inset: 0;
    z-index: 1;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: min(11svh, 9vw);
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--ink);
    pointer-events: none;
  }
  .words > span {
    will-change: transform, opacity;
  }

  @media (max-width: 767px) {
    .words {
      font-size: 11.5vw;
    }
  }

  /* No hold under reduced motion: the stage is one screen in the flow, over the poster. */
  @media (prefers-reduced-motion: reduce) {
    .section {
      height: auto;
    }
    .stage {
      position: relative;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { reduced, MOBILE_QUERY } from '../../shared/motion/policy';

  gsap.registerPlugin(ScrollTrigger);

  // Share of the track by which every word has settled. The words hold from there to the end.
  const CONVERGE_END = 0.7;
  // Delay between neighbouring words, in timeline units (the whole timeline spans the track, 0 to 1).
  const STAGGER = 0.04;

  const root = document.getElementById('projects');
  const video = document.querySelector<HTMLVideoElement>('[data-project-video]');

  // The video plays only while the section is on screen, and never under reduced motion, where the poster stays.
  if (video && root) {
    let visible = false;
    const sync = () => {
      if (visible && !reduced.matches) {
        video.play().catch(() => {});
      } else {
        video.pause();
      }
    };
    if (reduced.matches) {
      video.removeAttribute('autoplay');
      video.pause();
      video.load();
    }
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(root);
    reduced.onChange(() => {
      if (reduced.matches) video.pause();
      sync();
    });
  }

  // Convergence: each word starts pushed outward from the middle word (the further out, the further it travels)
  // and slides to its resting place as the track scrolls. Reversible, because the scrub follows scroll both ways.
  if (root && !reduced.matches) {
    const words = Array.from(root.querySelectorAll<HTMLElement>('.words > span'));
    const mobile = window.matchMedia(MOBILE_QUERY).matches;
    const middle = (words.length - 1) / 2;
    const travel = CONVERGE_END - (words.length - 1) * STAGGER;

    const ctx = gsap.context(() => {
      const timeline = gsap.timeline({
        defaults: { ease: 'power2.out' },
        scrollTrigger: { trigger: root, start: 'top top', end: 'bottom bottom', scrub: 0.5 },
      });
      words.forEach((word, i) => {
        const offset = i - middle;
        // Mobile keeps only the vertical spread, so the longest word never has to fit a narrow screen.
        const from = mobile
          ? { y: `${offset * 30}vh`, opacity: 0.2 }
          : { x: `${offset * 18}vw`, y: `${offset * 40}vh`, opacity: 0.2 };
        timeline.fromTo(word, from, { x: 0, y: 0, opacity: 1, duration: travel }, i * STAGGER);
      });
      // A zero-length tween at 1 stretches the timeline over the whole track, so the words hold after CONVERGE_END.
      timeline.to({}, { duration: 0 }, 1);
    }, root);

    const dispose = () => ctx.revert();
    window.addEventListener('pagehide', dispose);
  }
</script>
