---
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const words = t('work.mask').split('|');
---

<section id="projects" aria-labelledby="projects-title" class="section">
  <!--
    A still stage (sticky, 100svh): the video fills the screen and the area words sit centred over it, blended with
    difference. Nothing moves on scroll; the stage holds briefly and the next section scrolls over it. The particle
    layer stays off here through the page wrapper's data-particles="none".
  -->
  <h2 id="projects-title" class="sr-only">{t('work.title')}: {words.join(', ')}</h2>

  <div class="stage">
    <video
      class="bg"
      muted
      loop
      playsinline
      autoplay
      preload="metadata"
      poster="/video/projects-coast-poster.jpg"
      aria-hidden="true"
      data-project-video
    >
      <source src="/video/projects-coast-720.webm" type="video/webm" media="(max-width: 767px)" />
      <source src="/video/projects-coast-1080.webm" type="video/webm" />
      <source src="/video/projects-coast-720.mp4" type="video/mp4" media="(max-width: 767px)" />
      <source src="/video/projects-coast-1080.mp4" type="video/mp4" />
    </video>
    <div class="veil" aria-hidden="true"></div>

    <!-- Inverts whatever footage passes behind it (mix-blend-mode: difference), so it reads over sky and rock alike. -->
    <p class="words" aria-hidden="true">
      {words.map((word) => <span>{word}</span>)}
    </p>
  </div>
</section>

<style>
  /* The sticky stage plus a 30svh hold before the section scrolls away. Halved from 60svh so the
     next section arrives sooner. */
  .section {
    position: relative;
    isolation: isolate;
    height: calc(100svh + 30svh);
    /* Clips the sticky stage at the section's bottom edge. overflow: clip, unlike hidden, keeps sticky working. */
    overflow: clip;
    color: var(--ink);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--bg);
  }
  .bg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Softens the footage so the words keep their contrast. */
  .veil {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.45);
    pointer-events: none;
  }
  /* White text with difference blending inverts the footage behind each letter. */
  .words {
    position: absolute;
    inset: 0;
    z-index: 1;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: min(11svh, 9vw);
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .words {
      font-size: 11.5vw;
    }
  }

  /* No hold under reduced motion: the stage is one screen in the flow, over the poster. */
  @media (prefers-reduced-motion: reduce) {
    .section {
      height: auto;
    }
    .stage {
      position: relative;
    }
  }
</style>

<script>
  import { reduced } from '../../shared/motion/policy';

  const root = document.getElementById('projects');
  const video = document.querySelector<HTMLVideoElement>('[data-project-video]');

  // The video plays only while the section is on screen, and never under reduced motion, where the poster stays.
  if (video && root) {
    let visible = false;
    const sync = () => {
      if (visible && !reduced.matches) {
        video.play().catch(() => {});
      } else {
        video.pause();
      }
    };
    if (reduced.matches) {
      video.removeAttribute('autoplay');
      video.pause();
      video.load();
    }
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(root);
    reduced.onChange(() => {
      if (reduced.matches) video.pause();
      sync();
    });
  }
</script>
