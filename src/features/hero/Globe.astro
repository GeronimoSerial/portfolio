---
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<section id="globe" data-particles="globe" aria-labelledby="globe-title" class="scene">
  <div class="stage" data-particles-text>
    <div class="copy">
      <h2 id="globe-title" class="title">{t('globe.title')}</h2>
    </div>
  </div>
</section>

<style>
  .scene {
    position: relative;
    height: 130vh;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    padding: 0 32px;
  }

  .copy {
    max-width: 34vw;
  }

  .title {
    margin: 0;
    font-weight: 300;
  }

  .title {
    font-size: clamp(32px, 3.6vw, 56px);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  @media (max-width: 767px) {
    .stage {
      align-items: flex-start;
      padding: 96px 16px 0;
    }

    .copy {
      max-width: none;
    }

    .title {
      font-size: 36px;
    }
  }
</style>
