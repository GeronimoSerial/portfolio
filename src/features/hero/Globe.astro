---
import { useTranslations, type Lang } from '../../i18n/utils';
import GlobeRing from './GlobeRing.astro';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<section id="globe" data-particles="globe" aria-labelledby="globe-title" class="scene">
  <div class="stage" data-particles-text>
    <h2 id="globe-title" class="sr-only">{t('globe.title')}</h2>
  </div>
  <GlobeRing lang={Astro.props.lang} />
</section>

<style>
  .scene {
    position: relative;
    height: 130vh;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    box-sizing: border-box;
  }

  /* The title is spoken, not shown: the ring carries the visible text. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
